# ---------------------------------------------------------------------------
# Copia este archivo a .env y completa los valores. .env NO se versiona:
# contiene credenciales reales (AWS, base de datos, llaves de cifrado).
#
#   cp .env.example .env
#
# No subas .env a ningún repositorio, aunque sea privado.
# ---------------------------------------------------------------------------

# --- Base de datos -------------------------------------------------------
# postgresql://usuario:password@host:5432/basedatos
# La contraseña va URL-encoded si contiene @ : / o caracteres especiales.
DATABASE_URL=

# --- AWS / S3 ------------------------------------------------------------
# Credenciales con permisos mínimos: solo el bucket que usa la aplicación.
# La región debe coincidir con la del bucket; un bucket no se "transfiere"
# cambiando la región, así que verifica antes de subir.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# --- Llaves de la aplicación --------------------------------------------
# APP_DATA_KEY cifra los datos personales de los asociados.
# Debe ser una cadena de 64 caracteres. Generar con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_DATA_KEY=

# JWT_SECRET firma los tokens de sesión y los acuses de recibo.
# Generar con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=

# --- Sesión --------------------------------------------------------------
SESSION_DURATION_HOURS=2

# --- Datos institucionales ------------------------------------------------
# Se muestran en el encabezado, pie de página, acuses y documentos PDF.
# Los valores por defecto están en includes/config.php; esto solo los pisa.
MPV_NUMERO=MPV-DIR-001-2026
MPV_TITULO=Mesa de Partes Virtual
MPV_RESPONSABLE=Unidad de Tecnologías de la Información
MPV_RESPONSABLE_NOMBRE=Jefe/a de Mesa de Partes
MPV_CORREO=mesadepartes@amsp.org.pe
MPV_TELEFONO=(01) 331-0083 / 424-3262
MPV_HORARIO=Lunes a viernes de 8:00 a 17:00 h
MPV_APEX=Asociación Mutualista Sanitaria del Perú (AMSP)
MPV_DIRECCION=Jr. Ramón Dagnino 117, Santa Beatriz, Cercado de Lima

# --- Usuario inicial -----------------------------------------------------
# Solo se usa la primera vez, cuando no existe ningún usuario en la tabla
# `users`. Cambiar la contraseña después del primer arranque.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=super-admin
